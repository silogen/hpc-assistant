{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "aitta": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Aitta Inference Service",
      "options": {
        "baseURL": "https://api-staging-aitta.2.rahtiapp.fi/openai/v1",
        "apiKey": "{env:AITTA_TOKEN}"
      },
      "models": {
        "openai/gpt-oss-120b": {
          "name": "openai/gpt-oss-120b"
        }
      }
    }
  },
  "model": "aitta/openai/gpt-oss-120b",
  "permission": {
    "bash": {
      "*": "ask",
      "cat *": "allow",
      "ls *": "allow",
      "pwd": "allow",
      "head *": "allow",
      "tail *": "allow",
      "wc *": "allow",
      "find *": "allow",
      "which *": "allow",
      "echo *": "allow",
      "grep *": "allow",
      "diff *": "allow",
      "env": "allow",
      "whoami": "allow",
      "hostname": "allow",
      "date *": "allow",
      "git *": "ask",
      "git push *": "ask",
      "module *": "ask",
      "squeue *": "allow",
      "sacct *": "allow",
      "scontrol show *": "allow",
      "sbatch *": "ask",
      "scancel *": "ask",
      "srun *": "ask",
      "salloc *": "ask",
      "rm *": "ask",
      "rm -rf *": "deny",
      "chmod *": "ask",
      "chown *": "deny",
      "dd *": "deny",
      "mkfs *": "deny",
      "kill -9 *": "deny",
      "killall *": "deny",
      "reboot *": "deny",
      "shutdown *": "deny",
      "singularity *": "ask",
      "apptainer *": "ask"
    },
    "edit": "ask",
    "external_directory": "ask",
    "doom_loop": "deny"
  },
  "mcp": {
    "lumi-aif": {
      "type": "remote",
      "url": "https://lumi-aif-agents.2.rahtiapp.fi/mcp",
      "enabled": true
    }
  },
  "instructions": ["AGENTS.md"]
}
