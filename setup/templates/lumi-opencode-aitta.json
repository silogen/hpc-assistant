{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "aitta": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Aitta Inference Service",
      "options": {
        "baseURL": "https://aitta-api.csc.fi/openai/v1",
        "apiKey": "{env:AITTA_TOKEN}"
      },
      "models": {
        "LumiOpen/Llama-Poro-2-70B-Instruct": {
          "name": "LumiOpen/Llama-Poro-2-70B-Instruct"
        },
        "LumiOpen/Poro-34B-chat": {
          "name": "LumiOpen/Poro-34B-chat"
        },
        "Qwen/Qwen3-Coder-Next": {
          "name": "Qwen/Qwen3-Coder-Next"
        },
        "Qwen/Qwen3.6-27B": {
          "name": "Qwen/Qwen3.6-27B"
        },
        "Qwen/Qwen3.6-35B-A3B": {
          "name": "Qwen/Qwen3.6-35B-A3B"
        },
        "TinyLlama/TinyLlama-1.1B-Chat-v1.0": {
          "name": "TinyLlama/TinyLlama-1.1B-Chat-v1.0"
        },
        "Unbabel/Tower-Plus-9B": {
          "name": "Unbabel/Tower-Plus-9B"
        },
        "allenai/OLMo-7B-0724-Instruct": {
          "name": "allenai/OLMo-7B-0724-Instruct"
        },
        "google/gemma-4-31b-it": {
          "name": "google/gemma-4-31b-it"
        },
        "meta-llama/Llama-3.3-70B-Instruct": {
          "name": "meta-llama/Llama-3.3-70B-Instruct"
        },
        "mistralai/Ministral-3-14B-Reasoning-2512": {
          "name": "mistralai/Ministral-3-14B-Reasoning-2512"
        },
        "openai/gpt-oss-120b": {
          "name": "openai/gpt-oss-120b"
        },
        "swiss-ai/Apertus-70B-Instruct-2509": {
          "name": "swiss-ai/Apertus-70B-Instruct-2509"
        },
        "swiss-ai/Apertus-8B-Instruct-2509": {
          "name": "swiss-ai/Apertus-8B-Instruct-2509"
        }
      }
    }
  },
  "model": "aitta/openai/gpt-oss-120b",
  "permission": {
    "bash": {
      "*": "ask",
      "cat *": "allow",
      "ls *": "allow",
      "pwd": "allow",
      "head *": "allow",
      "tail *": "allow",
      "wc *": "allow",
      "find *": "allow",
      "which *": "allow",
      "echo *": "allow",
      "grep *": "allow",
      "diff *": "allow",
      "env": "allow",
      "whoami": "allow",
      "hostname": "allow",
      "date *": "allow",
      "git *": "ask",
      "git push *": "ask",
      "module *": "ask",
      "squeue *": "allow",
      "sacct *": "allow",
      "scontrol show *": "allow",
      "sbatch *": "ask",
      "scancel *": "ask",
      "srun *": "ask",
      "salloc *": "ask",
      "rm *": "ask",
      "rm -rf *": "deny",
      "chmod *": "ask",
      "chown *": "deny",
      "dd *": "deny",
      "mkfs *": "deny",
      "kill -9 *": "deny",
      "killall *": "deny",
      "reboot *": "deny",
      "shutdown *": "deny",
      "singularity *": "ask",
      "apptainer *": "ask"
    },
    "edit": "ask",
    "external_directory": "ask",
    "doom_loop": "deny"
  },
  "mcp": {
    "lumi-aif": {
      "type": "remote",
      "url": "https://lumi-aif-agents.2.rahtiapp.fi/mcp",
      "enabled": true
    }
  },
  "instructions": [
    "AGENTS.md"
  ]
}