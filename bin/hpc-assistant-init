#!/usr/bin/env bash
# Copyright Advanced Micro Devices, Inc.
#
# SPDX-License-Identifier: MIT
#
# Initialize HPC Assistant agent config in a project directory.
# Used after `module load hpc-assistant` on LUMI.
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: hpc-assistant-init [OPTIONS] [PROJECT_DIR]

Install site skills and agent config files into PROJECT_DIR (default: current
directory). Does not start services or prompt for API tokens.

Options:
  -d, --dir DIR           Project directory (default: $PWD)
  -f, --force             Overwrite existing AGENTS.md / opencode.json / CLAUDE.md
  --framework NAME        opencode (default) or claude-code
  --inference NAME        anthropic (default), aitta, or custom-openai. Applies
                          to both frameworks. With claude-code, aitta and
                          custom-openai need the LiteLLM proxy SIF; see
                          --sif-path.
  --api-base URL          Base URL of your OpenAI-compatible endpoint
                          (custom-openai only), e.g. http://localhost:8000/v1
  --model ID              Model id served by that endpoint (custom-openai only)
  --sif-path PATH         Path to aitta-proxy.sif (claude-code + aitta or
                          custom-openai only).
  --site NAME             HPC site (default: LUMI)
  --with-skill NAME       Opt in to an optional skill (repeatable). Currently:
                          geak-optimization
  --no-optional-skills    Do not install optional skills (overrides a saved list)
  --no-save-config        Do not write ~/.config/hpc-assistant/config.env
  -h, --help              Show this help

Local mode (agent runs on your own machine, cluster reached over SSH):
  --local                 Configure this project for local mode: writes
                          .hpc-assistant.json, appends a local-mode section to
                          the system prompt, requires approval for hpc-mcp tools
                          and raw ssh/scp/rsync, and denies local paths outside
                          the project. See LOCAL-MODE.md.
  --remote-host ALIAS     SSH host alias for the cluster, as defined in
                          ~/.ssh/config (default: lumi). Must be an alias, not a
                          user@hostname — that is what keeps credentials out of
                          the assistant entirely.
  --remote-root PATH      Project directory on the cluster, e.g.
                          /scratch/project_465000000/$USER/myapp. Everything the
                          assistant does remotely is bounded to this path.
  --account NAME          Slurm account to bill jobs to, e.g. project_465000000
  --file-access MODE      How files are shared with the cluster. Only rsync is
                          supported; see LOCAL-MODE.md.
  --partition NAME        Default Slurm partition (default: small-g)

Examples:
  module load hpc-assistant
  cd ~/projects/myapp && hpc-assistant-init
  export AITTA_TOKEN=... && opencode

  module load Local-LAIF lumi-aif-agents hpc-assistant
  hpc-assistant-init -d ~/projects/myapp

  # Claude Code against Aitta (requires the proxy SIF + launch.sh):
  hpc-assistant-init --framework claude-code --inference aitta \
    --sif-path ~/.local/share/hpc-assistant/sif/aitta-proxy.sif

  # Your own OpenAI-compatible endpoint (vLLM, llama.cpp, Ollama, gateway, ...):
  hpc-assistant-init --inference custom-openai \
    --api-base http://localhost:8000/v1 --model meta-llama/Llama-3.3-70B-Instruct
  export CUSTOM_API_KEY=...   # only if your endpoint checks it
  opencode

  # Local mode: agent on your laptop, LUMI reached over your own SSH connection.
  # Run this in a local clone of your project, not on the cluster:
  hpc-assistant-init --local \
    --remote-host lumi \
    --remote-root /scratch/project_465000000/$USER/myapp \
    --account project_465000000
  export AITTA_TOKEN=... && opencode
  # Opt in to the GEAK kernel-optimizer skill (not installed by default):
  hpc-assistant-init --with-skill geak-optimization
EOF
}

HPC_ASSISTANT_ROOT="${HPC_ASSISTANT_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
PROJECT_TARGET="${PWD}"
FORCE_CONFIG_OVERWRITE=false
AGENT_FRAMEWORK="opencode"
INFERENCE_BACKEND="anthropic"
AITTA_PROXY_SIF="${AITTA_PROXY_SIF:-}"
CUSTOM_API_BASE="${CUSTOM_API_BASE:-}"
CUSTOM_MODEL="${CUSTOM_MODEL:-}"
HPC_SITE="LUMI"
USE_DEFAULTS=true
KB_BACKEND="remote-mcp"
SAVE_CONFIG=true
LOCAL_MODE=false
REMOTE_HOST="${REMOTE_HOST:-}"
REMOTE_ROOT="${REMOTE_ROOT:-}"
SLURM_ACCOUNT="${SLURM_ACCOUNT:-}"
FILE_ACCESS_MODE="${FILE_ACCESS_MODE:-}"
SSHFS_MOUNTPOINT="${SSHFS_MOUNTPOINT:-}"
DEFAULT_PARTITION="${DEFAULT_PARTITION:-}"
CLEAR_OPTIONAL_SKILLS=false
WITH_OPTIONAL_SKILLS=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    -d|--dir)
      PROJECT_TARGET="$2"
      shift 2
      ;;
    -f|--force)
      FORCE_CONFIG_OVERWRITE=true
      shift
      ;;
    --framework)
      AGENT_FRAMEWORK="$2"
      shift 2
      ;;
    --inference)
      INFERENCE_BACKEND="$2"
      shift 2
      ;;
    --api-base)
      CUSTOM_API_BASE="$2"
      shift 2
      ;;
    --model)
      CUSTOM_MODEL="$2"
      shift 2
      ;;
    --sif-path)
      AITTA_PROXY_SIF="$2"
      shift 2
      ;;
    --site)
      HPC_SITE="$2"
      shift 2
      ;;
    --local)
      LOCAL_MODE=true
      shift
      ;;
    --remote-host)
      REMOTE_HOST="$2"
      shift 2
      ;;
    --remote-root)
      REMOTE_ROOT="$2"
      shift 2
      ;;
    --account)
      SLURM_ACCOUNT="$2"
      shift 2
      ;;
    --file-access)
      FILE_ACCESS_MODE="$2"
      shift 2
      ;;
    --sshfs-mountpoint)
      SSHFS_MOUNTPOINT="$2"
      shift 2
      ;;
    --partition)
      DEFAULT_PARTITION="$2"
      shift 2
      ;;
    --with-skill)
      if [[ -z "${2:-}" || "$2" == -* ]]; then
        echo "ERROR: --with-skill requires a skill name" >&2
        exit 1
      fi
      WITH_OPTIONAL_SKILLS+=("$2")
      shift 2
      ;;
    --no-optional-skills)
      CLEAR_OPTIONAL_SKILLS=true
      shift
      ;;
    --no-save-config)
      SAVE_CONFIG=false
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    -*)
      echo "Unknown option: $1" >&2
      usage >&2
      exit 1
      ;;
    *)
      PROJECT_TARGET="$1"
      shift
      ;;
  esac
done

PROJECT_TARGET="$(cd "$PROJECT_TARGET" && pwd)"

export HPC_ASSISTANT_ROOT
export PROJECT_DIR="$HPC_ASSISTANT_ROOT"
export SETUP_DIR="$HPC_ASSISTANT_ROOT/setup"
export SKILLS_DIR="$HPC_ASSISTANT_ROOT/skills"
export FORCE_CONFIG_OVERWRITE
export USE_DEFAULTS
export KB_BACKEND
export INFERENCE_BACKEND
export AGENT_FRAMEWORK
export HPC_SITE
export AITTA_PROXY_SIF
export CUSTOM_API_BASE
export CUSTOM_MODEL
export LOCAL_MODE
export LOCAL_ROOT="$PROJECT_TARGET"
export REMOTE_HOST
export REMOTE_ROOT
export SLURM_ACCOUNT
export FILE_ACCESS_MODE
export SSHFS_MOUNTPOINT
export DEFAULT_PARTITION

# shellcheck source=../setup/config.sh
source "$SETUP_DIR/config.sh"

case "$INFERENCE_BACKEND" in
  anthropic|aitta) ;;
  custom-openai)
    if [[ -z "$CUSTOM_API_BASE" || -z "$CUSTOM_MODEL" ]]; then
      echo "ERROR: --inference custom-openai requires --api-base and --model" >&2
      echo "       (or the CUSTOM_API_BASE / CUSTOM_MODEL environment variables)." >&2
      exit 1
    fi
    ;;
  *)
    echo "ERROR: Unknown inference backend: $INFERENCE_BACKEND" >&2
    echo "       Expected: anthropic, aitta, or custom-openai" >&2
    exit 1
    ;;
esac

get_site_config "$HPC_SITE"

if [[ "$LOCAL_MODE" == "true" ]]; then
  local_mode_defaults
  validate_file_access_mode "$FILE_ACCESS_MODE" || exit 1

  if [[ -z "$REMOTE_ROOT" ]]; then
    echo "ERROR: --local requires --remote-root: the project directory on the cluster." >&2
    echo "       Everything the assistant does remotely is bounded to that path, so" >&2
    echo "       there is no safe default. For example:" >&2
    echo "         --remote-root /scratch/project_465000000/\$USER/myapp" >&2
    exit 1
  fi
  case "$REMOTE_HOST" in
    *@*)
      echo "ERROR: --remote-host must be an SSH host alias, not user@hostname." >&2
      echo "       Define a Host block in ~/.ssh/config and pass its name, so that" >&2
      echo "       authentication stays with your ssh-agent. See LOCAL-MODE.md." >&2
      exit 1
      ;;
  esac
  if [[ -z "$SLURM_ACCOUNT" ]]; then
    echo "WARNING: no --account given; job submission will need one. Add it to" >&2
    echo "         .hpc-assistant.json under remote.account before submitting." >&2
    echo "" >&2
  fi
fi

ENABLED_OPTIONAL_SKILLS=""
if [[ "$CLEAR_OPTIONAL_SKILLS" != "true" ]]; then
  load_saved_optional_skills
fi
if [[ ${#WITH_OPTIONAL_SKILLS[@]} -gt 0 ]]; then
  for skill in "${WITH_OPTIONAL_SKILLS[@]}"; do
    enable_optional_skill "$skill"
  done
fi
export ENABLED_OPTIONAL_SKILLS

# Claude Code in front of an OpenAI-compatible endpoint needs the LiteLLM proxy
# SIF. Default the path if the user didn't pass --sif-path, and warn loudly that
# this combination requires the proxy (started by launch.sh), unlike OpenCode
# which talks to such endpoints directly.
if uses_litellm_proxy; then
  AITTA_PROXY_SIF="${AITTA_PROXY_SIF:-$DEFAULT_SIF_DIR/aitta-proxy.sif}"
  export AITTA_PROXY_SIF
fi

echo "HPC Assistant — project init"
echo "  Install root : $HPC_ASSISTANT_ROOT"
echo "  Project dir    : $PROJECT_TARGET"
echo "  Site           : $HPC_SITE"
echo "  Placement      : $([[ "$LOCAL_MODE" == "true" ]] && echo "local (cluster over SSH)" || echo "on-cluster")"
if [[ "$LOCAL_MODE" == "true" ]]; then
  echo "  Remote host    : $REMOTE_HOST"
  echo "  Remote root    : $REMOTE_ROOT"
  echo "  Slurm account  : ${SLURM_ACCOUNT:-<unset>}"
  echo "  File access    : $FILE_ACCESS_MODE"
  if [[ "$FILE_ACCESS_MODE" == "sshfs" ]]; then
    echo "  Mountpoint     : $SSHFS_MOUNTPOINT"
  fi
fi
echo "  Framework      : $AGENT_FRAMEWORK"
echo "  Knowledge base : $KB_BACKEND"
echo "  Inference      : $INFERENCE_BACKEND"
echo "  Optional skills: ${ENABLED_OPTIONAL_SKILLS:-none}"
if [[ "$INFERENCE_BACKEND" == "custom-openai" ]]; then
  echo "  Endpoint       : $CUSTOM_API_BASE"
  echo "  Model          : $CUSTOM_MODEL"
fi
if uses_litellm_proxy; then
  echo "  Proxy SIF      : $AITTA_PROXY_SIF"
fi
echo ""

if uses_litellm_proxy; then
  echo "WARNING: Claude Code + $INFERENCE_BACKEND requires the LiteLLM proxy (aitta-proxy.sif)."
  echo "         OpenCode talks to OpenAI-compatible endpoints directly, but Claude"
  echo "         Code only speaks the Anthropic API, so requests must go through the proxy."
  if [[ ! -f "$AITTA_PROXY_SIF" ]]; then
    echo "         SIF not found at: $AITTA_PROXY_SIF"
    echo "         Build/pull it (see README) or pass --sif-path, then run:"
    echo "             bash $SETUP_DIR/setup.sh     # save endpoint credentials"
    echo "             bash $SETUP_DIR/launch.sh    # starts the proxy + Claude Code"
  fi
  echo ""
fi

case "$AGENT_FRAMEWORK" in
  opencode)
    configure_opencode_project "$PROJECT_TARGET"
    ;;
  claude-code)
    configure_claude_code_project "$PROJECT_TARGET"
    ;;
  *)
    echo "ERROR: Unsupported framework: $AGENT_FRAMEWORK" >&2
    exit 1
    ;;
esac

if [[ "$LOCAL_MODE" == "true" ]]; then
  configure_local_project "$PROJECT_TARGET"
fi

if [[ "$SAVE_CONFIG" == "true" ]]; then
  save_module_init_config
  echo ""
  echo "Saved module defaults to $CONFIG_FILE"
fi

echo ""
echo "Next steps:"
echo "  cd $PROJECT_TARGET"
case "$AGENT_FRAMEWORK" in
  opencode)
    if [[ "$INFERENCE_BACKEND" == "aitta" ]]; then
      echo "  export AITTA_TOKEN=<your-token>"
      echo "  opencode    # or: bash $SETUP_DIR/launch.sh (after saving credentials via setup.sh)"
    elif [[ "$INFERENCE_BACKEND" == "custom-openai" ]]; then
      echo "  export CUSTOM_API_KEY=<your-key>   # skip if your endpoint ignores it"
      echo "  opencode    # endpoint + model are baked into opencode.json"
    else
      echo "  export ANTHROPIC_API_KEY=<your-key>"
      echo "  opencode"
    fi
    ;;
  claude-code)
    if uses_litellm_proxy; then
      echo "  # Claude Code + $INFERENCE_BACKEND runs through the LiteLLM proxy; launch.sh starts it."
      echo "  bash $SETUP_DIR/setup.sh     # one-time: pull aitta-proxy.sif + save credentials"
      echo "  bash $SETUP_DIR/launch.sh    # starts the proxy (hosted_vllm) + Claude Code"
    else
      echo "  export ANTHROPIC_API_KEY=<your-key>"
      echo "  claude    # or: bash $SETUP_DIR/launch.sh (after saving credentials via setup.sh)"
    fi
    ;;
esac

if [[ "$LOCAL_MODE" == "true" ]]; then
  echo ""
  echo "Local mode — before your first session:"
  echo "  1. Confirm the connection works and is multiplexed:"
  echo "       ssh $REMOTE_HOST true && ssh -O check $REMOTE_HOST"
  case "$FILE_ACCESS_MODE" in
    git)
      echo "  2. Make sure both sides track the same git remote, so neither is"
      echo "     authoritative by fiat:"
      echo "       git -C . remote -v"
      echo "       ssh $REMOTE_HOST \"git -C '$REMOTE_ROOT' remote -v\""
      ;;
    sshfs)
      echo "  2. Mount the cluster directory (keep the mountpoint outside this project):"
      echo "       mkdir -p \"$SSHFS_MOUNTPOINT\""
      echo "       sshfs $REMOTE_HOST:\"$REMOTE_ROOT\" \"$SSHFS_MOUNTPOINT\" \\"
      echo "         -o reconnect,ServerAliveInterval=15,ServerAliveCountMax=3"
      echo "     Unmount when you are done, and after any dropped connection:"
      if [[ "$(uname -s)" == "Darwin" ]]; then
        echo "       umount \"$SSHFS_MOUNTPOINT\""
      else
        echo "       fusermount -u \"$SSHFS_MOUNTPOINT\""
      fi
      ;;
    rsync)
      echo "  2. Check what a push would transfer before trusting it (never add --delete):"
      echo "       rsync -avn ./ $REMOTE_HOST:\"$REMOTE_ROOT\"/"
      ;;
  esac
  echo "  3. Read LOCAL-MODE.md, and review .hpc-assistant.json — its limits are the"
  echo "     policy boundary the assistant enforces."
fi
